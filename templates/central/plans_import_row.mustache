{{!
    @template local_dimensions/central/plans_import_row

    One projected row of a learning plan CSV import preview: its verdict badge, why, what would
    change, how it can be resolved, and its competency links.

    Rendered on its own so the apply step can repaint a single row in place without rebuilding
    the whole preview. The apply selection is read back from the data attributes on the wrapper —
    item key, fingerprint and verdict — so the browser sends choices, never data.

    Context variables required:
    * itemkey (string) · fingerprint (string) · verdict (string) · verdictlabel (string)
    * verdictbadge (string) · rownumber (int) · rownumberlabel (string)
    * shortname (string) · templateidnumber (string)
    * hasreason (bool) · reasonlabel (string) · hasdetail (bool) · detail (string)
    * selectable (bool) · preselected (bool) · checkboxid (string) · selectlabel (string)
    * hasoutcome (bool) · outcomelabel (string) · outcomebadge (string) · set only on a repaint
    * hasdiff (bool) · diff (array) {field, from, to}
    * hasremedies (bool) · remedies (array) {remedy, label, selected, name, id}
    * hasremaps (bool) · remaps (array) of token, value, id, label and an options list of
      value and label · the nested braces are spelled out here on purpose: a literal double
      closing brace would end this comment early, exactly as an embedded tag would
    * haslinks (bool) · links (array) {itemkey, name, statuslabel, statusbadge, confidencelabel,
      hasdetail, detail, selectable, preselected, checkboxid}
    * hasblast (bool) · blastlabel (string)

    Example context (json):
    {
        "itemkey": "t0",
        "fingerprint": "6b2f0c1d",
        "verdict": "update",
        "verdictlabel": "Update",
        "verdictbadge": "bg-primary",
        "rownumber": 2,
        "rownumberlabel": "Row 2",
        "shortname": "Induction plan",
        "templateidnumber": "TPL-IND",
        "hasreason": false,
        "reasonlabel": "",
        "hasdetail": false,
        "detail": "",
        "selectable": true,
        "preselected": true,
        "checkboxid": "ld-tplimp-t0",
        "selectlabel": "Select Induction plan",
        "hasoutcome": true,
        "outcomelabel": "Updated",
        "outcomebadge": "bg-success",
        "hasdiff": true,
        "diff": [{"field": "shortname", "from": "Induction", "to": "Induction plan"}],
        "hasremedies": false,
        "remedies": [],
        "hasremaps": true,
        "remaps": [
            {"token": "cf_tag1", "value": "Year 1", "id": "ld-tplimp-remap-t0-cf_tag1",
             "label": "cf_tag1: \"Year 1\" has no option here",
             "options": [{"value": "", "label": "Clear this value"}, {"value": "Stage 1", "label": "Stage 1"}]}
        ],
        "haslinks": true,
        "links": [
            {"itemkey": "t0l0", "name": "Communication (COMM-01) · CORE", "statuslabel": "Matched",
             "statusbadge": "bg-success", "confidencelabel": "Matched by ID number", "hasdetail": false,
             "detail": "", "selectable": true, "preselected": true, "checkboxid": "ld-tplimp-t0l0"}
        ],
        "hasblast": true,
        "blastlabel": "12 open plans, 3 completed plans, 1 cohorts, 1 competencies added, 0 kept"
    }
}}
<div class="local-dimensions-tplimport-row" data-region="import-row" data-itemkey="{{itemkey}}"
     data-fingerprint="{{fingerprint}}" data-verdict="{{verdict}}">
    <div class="local-dimensions-tplimport-rowhead">
        {{#selectable}}
        <input type="checkbox" class="form-check-input mt-0" data-region="item-check" id="{{checkboxid}}"
               {{#preselected}}checked{{/preselected}}>
        <label class="visually-hidden" for="{{checkboxid}}">{{selectlabel}}</label>
        {{/selectable}}
        <span class="badge {{verdictbadge}}">{{verdictlabel}}</span>
        <span class="local-dimensions-tplimport-name">{{shortname}}</span>
        {{#templateidnumber}}<span class="local-dimensions-tplimport-id">{{templateidnumber}}</span>{{/templateidnumber}}
        <span class="local-dimensions-tplimport-rownum">{{rownumberlabel}}</span>
        <span class="local-dimensions-tplimport-outcome" data-region="outcome">
            {{#hasoutcome}}<span class="badge {{outcomebadge}}">{{outcomelabel}}</span>{{/hasoutcome}}
        </span>
    </div>

    {{#hasreason}}
    <p class="local-dimensions-tplimport-reason">{{reasonlabel}}{{#hasdetail}} {{detail}}{{/hasdetail}}</p>
    {{/hasreason}}

    {{#hasdiff}}
    <ul class="local-dimensions-tplimport-diff">
        {{#diff}}
        <li><span class="local-dimensions-tplimport-field">{{field}}</span>
            <span class="local-dimensions-tplimport-from">{{from}}</span>
            <span aria-hidden="true">&rarr;</span>
            <span class="local-dimensions-tplimport-to">{{to}}</span></li>
        {{/diff}}
    </ul>
    {{/hasdiff}}

    {{#hasremedies}}
    <div class="local-dimensions-tplimport-remedies" role="radiogroup"
         aria-label="{{#str}}central_plans_import_row_remedy, local_dimensions{{/str}}">
        <span class="local-dimensions-tplimport-sublabel">{{#str}}central_plans_import_row_remedy, local_dimensions{{/str}}</span>
        {{#remedies}}
        <span class="local-dimensions-tplimport-remedy">
            <input type="radio" class="form-check-input mt-0" data-region="remedy" name="{{name}}" id="{{id}}"
                   value="{{remedy}}" {{#selected}}checked{{/selected}}>
            <label for="{{id}}">{{label}}</label>
        </span>
        {{/remedies}}
    </div>
    {{/hasremedies}}

    {{#hasremaps}}
    <div class="local-dimensions-tplimport-remaps">
        {{#remaps}}
        <span class="local-dimensions-tplimport-remap">
            <label for="{{id}}">{{label}}</label>
            <select class="form-select form-select-sm" id="{{id}}" data-region="remap" data-token="{{token}}">
                {{#options}}
                <option value="{{value}}">{{label}}</option>
                {{/options}}
            </select>
        </span>
        {{/remaps}}
    </div>
    {{/hasremaps}}

    {{#haslinks}}
    <div class="local-dimensions-tplimport-links">
        <span class="local-dimensions-tplimport-sublabel">{{#str}}central_plans_import_row_links, local_dimensions{{/str}}</span>
        <ul>
            {{#links}}
            <li data-region="import-link" data-itemkey="{{itemkey}}">
                {{#selectable}}
                <input type="checkbox" class="form-check-input mt-0" data-region="link-check" id="{{checkboxid}}"
                       {{#preselected}}checked{{/preselected}}>
                <label for="{{checkboxid}}">{{name}}</label>
                {{/selectable}}
                {{^selectable}}
                <span class="local-dimensions-tplimport-linkname">{{name}}</span>
                {{/selectable}}
                <span class="badge {{statusbadge}}">{{statuslabel}}</span>
                {{#hasdetail}}<span class="local-dimensions-tplimport-linkdetail">{{detail}}</span>{{/hasdetail}}
            </li>
            {{/links}}
        </ul>
    </div>
    {{/haslinks}}

    {{#hasblast}}
    <p class="local-dimensions-tplimport-blast">{{blastlabel}}</p>
    {{/hasblast}}
</div>
