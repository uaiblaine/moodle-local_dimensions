{{!
    @template local_dimensions/hero_header

    Hero Header template for competency display.

    Context variables required:
    * title (string) - The competency shortname (formatted)
    * description (string) - The competency description (formatted HTML)
    * hasdescription (bool) - Whether description exists
    * bgcolor (string) - Custom background color in hex format (optional)
    * hasbgcolor (bool) - Whether custom bgcolor exists
    * textcolor (string) - Custom text color in hex format (optional)
    * hastextcolor (bool) - Whether custom textcolor exists
    * duedate (string) - Formatted due date (optional)
    * hasduedate (bool) - Whether due date exists
    * duedateiconurl (string) - URL for due date icon
    * slim (bool) - Whether the hero starts folded to its slim state (title + due date only)
    * herokey (string) - This hero's own key in the stored fold list ('p' or 'c' plus an id)
    * herostatejson (string) - The whole stored fold list, as JSON

    The handle at the hero's bottom edge folds the header between its open and slim states.
    The choice is the learner's own, per plan and per competency, and is stored as a user
    preference, so the state below is already resolved server-side; local_dimensions/hero_collapse
    only flips it from there. The whole list travels with it because a write replaces the entire
    preference - see the module.

    @copyright  2026 Anderson Blaine
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "title": "Communication Skills",
        "description": "<p>Develop effective communication...</p>",
        "hasdescription": true,
        "bgcolor": "#3498db",
        "hasbgcolor": true,
        "textcolor": "#ffffff",
        "hastextcolor": true,
        "duedate": "31 Jan 2026",
        "hasduedate": true,
        "duedateiconurl": "/pluginfile.php/1/local_dimensions/status/calendar-light.svg",
        "slim": false,
        "herokey": "p12",
        "herostatejson": "[]"
    }
}}
<div class="local-dimensions-hero-wrapper {{#hasbgimage}}local-dimensions-hero-has-image{{/hasbgimage}} {{#slim}}local-dimensions-hero-slim{{/slim}}" id="local-dimensions-hero"
     {{#hasbgimage}}style="--hero-bg-image: url('{{bgimage}}'); {{#hasbgcolor}}--hero-overlay-color: {{bgcolor}};{{/hasbgcolor}}"{{/hasbgimage}}>
    <div class="local-dimensions-hero {{^hasbgcolor}}{{^hasbgimage}}bg-primary{{/hasbgimage}}{{/hasbgcolor}}"
         style="{{#hasbgcolor}}{{^hasbgimage}}background-color: {{bgcolor}};{{/hasbgimage}}{{/hasbgcolor}}{{#hastextcolor}} color: {{textcolor}};{{/hastextcolor}}">
        <div class="local-dimensions-hero-content" id="local-dimensions-hero-content">
            <h1 class="local-dimensions-hero-title">{{{title}}}</h1>
            {{#hasdescription}}
                <div class="local-dimensions-hero-description">
                    {{#description}}
                        {{> local_dimensions/collapsible_description }}
                    {{/description}}
                </div>
            {{/hasdescription}}
            {{#hasduedate}}
            <div class="local-dimensions-duedate-card">
                <img class="local-dimensions-duedate-icon" src="{{duedateiconurl}}" alt="" aria-hidden="true">
                <div class="local-dimensions-duedate-content">
                    <span class="local-dimensions-duedate-label">{{#str}}duedate, local_dimensions{{/str}}</span>
                    <span class="local-dimensions-duedate-value">{{duedate}}</span>
                </div>
            </div>
            {{/hasduedate}}
        </div>
        <button type="button"
                class="local-dimensions-hero-collapse"
                data-hero-collapse
                data-hero-key="{{herokey}}"
                data-hero-state="{{herostatejson}}"
                aria-controls="local-dimensions-hero-content"
                aria-expanded="{{#slim}}false{{/slim}}{{^slim}}true{{/slim}}"
                data-label-collapse="{{#str}}hero_collapse, local_dimensions{{/str}}"
                data-label-expand="{{#str}}hero_expand, local_dimensions{{/str}}">
            <i class="fa {{#slim}}fa-chevron-down{{/slim}}{{^slim}}fa-chevron-up{{/slim}}" aria-hidden="true"></i>
            <span data-hero-collapse-label>{{#slim}}{{#str}}hero_expand, local_dimensions{{/str}}{{/slim}}{{^slim}}{{#str}}hero_collapse, local_dimensions{{/str}}{{/slim}}</span>
        </button>
    </div>
</div>
