{{!
    @template local_dimensions/reportbuilder_link

    A link in a report-builder column cell.

    Context variables required:
    * url (string) - The link target, in its plain spelling
    * text (string) - The link text, in its plain spelling

    @copyright  2026 Anderson Blaine
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "url": "https://example.com/admin/tool/lp/plan.php?id=3",
        "text": "Onboarding plan"
    }
}}
<a href="{{url}}">{{text}}</a>
