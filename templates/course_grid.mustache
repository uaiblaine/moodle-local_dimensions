{{!
    @template local_dimensions/course_grid

    Grid container for course cards.

    Context variables required:
    * courses (array) - Array of course objects to render

    @copyright  2026 Anderson Blaine
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "courses": [
            {
                "courseid": 42,
                "fullname": "Course 1",
                "courseurl": "/course/view.php?id=42",
                "viewcoursestr": "View course: Course 1",
                "locked": false,
                "skeletonrows": [{"row": true}, {"row": true}, {"row": true}]
            }
        ]
    }
}}
<div id="local-dimensions-viewcompetency-grid"
     class="row mt-4"
     role="region"
     aria-label="{{#str}}view_courses, local_dimensions{{/str}}"
     aria-live="polite"
     aria-relevant="additions text"
     aria-busy="true">
    {{! Busy until competency_view.js has drawn or failed every card, so the live region speaks
        once, over the finished grid. The status line is the one spoken sign of the wait. }}
    <span class="visually-hidden" role="status" data-region="local-dimensions-grid-loading">{{#str}}loading_progress, local_dimensions{{/str}}</span>
    {{#courses}}
        {{> local_dimensions/course_card}}
    {{/courses}}
</div>
