{{!
    @template local_dimensions/view_competency

    Main template for the view competency page (Competency Tracker Mode).
    Renders the hero header, the filter line (local_dimensions/filter_line: scope, search and
    Filters) and the course grid with its "no results" state.

    Context variables required:
    * hascompetency (bool) - Whether a competency is selected
    * hascourses (bool) - Whether there are courses to display
    * hero (object) - Hero header data (title, description, hasdescription, bgcolor, hasbgcolor)
    * courses (array) - Array of course objects
    * hascustomcss (bool) - Whether there is custom CSS to inject
    * customcss (string) - Compiled CSS from competency SCSS custom field
    * line (object) - The filter line's context (local_dimensions/filter_line)
    * viewstatejson (string) - The whole stored view state, for the client to seed from

    @copyright  2026 Anderson Blaine
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "hascompetency": true,
        "hascourses": true,
        "hero": {
            "title": "Communication Skills",
            "description": "<p>Description here</p>",
            "hasdescription": true,
            "bgcolor": "#3498db",
            "hasbgcolor": true
        },
        "courses": []
    }
}}
{{#hascustomcss}}
<textarea hidden id="local-dimensions-customcss-source-viewcompetency">{{customcss}}</textarea>
{{/hascustomcss}}
<div class="percentagemode-{{percentagemode}}">

{{#hascompetency}}
    {{#hero}}
        {{> local_dimensions/hero_header}}
    {{/hero}}
{{/hascompetency}}

{{#hascourses}}
    {{! The filter line: the scope (hidden until the completion batch answers, because the counts
        are unknowable before it), the search over the cards drawn, and Filters when course
        fields are configured; then the row of chips. }}
    {{#line}}
    {{> local_dimensions/filter_line }}
    {{/line}}
    <div data-region="local-dimensions-tracker"
         data-viewstate="{{viewstatejson}}">
        {{> local_dimensions/course_grid}}
        {{! Outside the grid's region, and never a card wrapper: the filters hide those. }}
        <div id="local-dimensions-viewcompetency-noresults" class="local-dimensions-empty" role="status" hidden>
            <span class="local-dimensions-empty-icon">
                <i class="fa fa-search" aria-hidden="true"></i>
            </span>
            <span class="local-dimensions-empty-title">
                {{#str}}line_noresults_courses, local_dimensions{{/str}}
            </span>
            <span class="local-dimensions-empty-text">
                {{#str}}line_noresults_courses_note, local_dimensions{{/str}}
            </span>
            <button type="button" class="local-dimensions-empty-action" data-noresults-clear>
                {{#str}}filter_chip_clear, local_dimensions{{/str}}
            </button>
        </div>
    </div>
{{/hascourses}}

{{^hascourses}}
    {{#hascompetency}}
        <div class="local-dimensions-empty" role="status">
            <span class="local-dimensions-empty-icon">
                <i class="fa fa-graduation-cap" aria-hidden="true"></i>
            </span>
            <span class="local-dimensions-empty-title">
                {{#str}}no_courses_linked, local_dimensions{{/str}}
            </span>
            <span class="local-dimensions-empty-text">
                {{#str}}no_courses_linked_note, local_dimensions{{/str}}
            </span>
        </div>
    {{/hascompetency}}
{{/hascourses}}

{{^hascompetency}}
    <div class="local-dimensions-empty" role="status">
        <span class="local-dimensions-empty-icon local-dimensions-empty-icon-warning">
            <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
        </span>
        <span class="local-dimensions-empty-title">
            {{#str}}competency_id_missing, local_dimensions{{/str}}
        </span>
        <span class="local-dimensions-empty-text">
            {{#str}}competency_id_missing_note, local_dimensions{{/str}}
        </span>
    </div>
{{/hascompetency}}

</div>
